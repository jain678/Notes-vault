    "test:e2e": "node tests/e2e.mjs http://localhost:3000"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
