    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "lowlight": "^3.3.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
